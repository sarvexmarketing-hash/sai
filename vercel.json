{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/workspace",
      "destination": "/workspace.html"
    },
    {
      "source": "/workspace/(.*)",
      "destination": "/workspace.html"
    }
  ]
}
